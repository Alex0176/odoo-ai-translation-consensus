<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_translation_provider_list" model="ir.ui.view">
        <field name="name">ai.translation.provider.list</field>
        <field name="model">ai.translation.provider</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="model"/>
                <field name="purpose_ids" widget="many2many_tags" options="{'color_field': 'color'}" width="250px"/>
                <field name="role" optional="hide"/>
                <field name="can_read_documents" optional="hide"/>
                <field name="allow_documents_external" optional="hide"/>
                <field name="needs_key" optional="show"/>
                <field name="is_local" optional="show"/>
                <field name="weight" optional="hide"/>
                <field name="last_status" widget="badge"
                       decoration-success="last_status == 'ok'" decoration-danger="last_status == 'error'"/>
                <field name="last_check" optional="hide"/>
                <field name="paused_until" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_ai_translation_provider_form" model="ir.ui.view">
        <field name="name">ai.translation.provider.form</field>
        <field name="model">ai.translation.provider</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test" type="object" string="Test connection" class="btn-primary"/>
                    <button name="action_resume" type="object" string="Use again now" invisible="not is_paused"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group string="Service">
                            <field name="name"/>
                            <field name="kind"/>
                            <field name="base_url"/>
                            <field name="model" invisible="kind in ('deepl', 'google', 'azure', 'libretranslate', 'mymemory', 'lingva')"/>
                            <field name="region" invisible="kind != 'azure'"/>
                            <field name="command" invisible="kind != 'command'" placeholder="claude -p --tools '' --no-session-persistence"/>
                            <field name="active"/>
                        </group>
                        <group string="Access">
                            <field name="needs_key"/>
                            <field name="api_key" password="True" invisible="not needs_key"/>
                            <field name="api_key_env" invisible="not needs_key" placeholder="OPENAI_API_KEY"/>
                            <field name="last_status"/>
                            <field name="last_message"/>
                            <field name="last_check"/>
                            <field name="is_paused" invisible="1"/>
                            <field name="paused_until" invisible="not is_paused"/>
                            <field name="pause_reason" invisible="not is_paused"/>
                        </group>
                        <group string="Role">
                            <field name="purpose_ids" widget="many2many_tags"
                                   options="{'color_field': 'color', 'no_create': True}"/>
                            <field name="can_read_documents"/>
                            <field name="allow_documents_external"
                                   invisible="is_local or not can_read_documents"/>
                            <div class="alert alert-warning" role="alert" colspan="2"
                                 invisible="is_local or not can_read_documents">
                                Invoices contain data of third parties (suppliers, bank accounts, tax numbers).
                                An external provider only reads invoices when "Allow invoices to leave the
                                server" is switched on.
                            </div>
                            <field name="role"/>
                            <field name="weight"/>
                            <field name="is_local"/>
                            <field name="timeout"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Prices (for the cost display)" invisible="not needs_key">
                            <field name="price_input" invisible="kind in ('deepl', 'google', 'azure', 'libretranslate', 'mymemory', 'lingva')"/>
                            <field name="price_output" invisible="kind in ('deepl', 'google', 'azure', 'libretranslate', 'mymemory', 'lingva')"/>
                            <field name="price_chars" invisible="kind not in ('deepl', 'google', 'azure', 'libretranslate', 'mymemory', 'lingva')"/>
                        </group>
                        <group string="Advanced">
                            <field name="extra_json" placeholder='{"body": {"temperature": 0.2}}'/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_translation_provider_search" model="ir.ui.view">
        <field name="name">ai.translation.provider.search</field>
        <field name="model">ai.translation.provider</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="kind"/>
                <field name="purpose_ids"/>
                <filter name="purpose_translate" string="Translations"
                        domain="[('purpose_ids.code', '=', 'translate')]"/>
                <filter name="purpose_invoice" string="Invoices"
                        domain="[('purpose_ids.code', 'in', ('invoice_manual', 'invoice_auto'))]"/>
                <filter name="purpose_invoice_manual" string="Invoices - manual"
                        domain="[('purpose_ids.code', '=', 'invoice_manual')]"/>
                <filter name="purpose_invoice_auto" string="Invoices - automatic"
                        domain="[('purpose_ids.code', '=', 'invoice_auto')]"/>
                <separator/>
                <filter name="reads_documents" string="Can read documents" domain="[('can_read_documents', '=', True)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_ai_translation_provider" model="ir.actions.act_window">
        <field name="name">Providers</field>
        <field name="res_model">ai.translation.provider</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No providers</p>
            <p>
                Providers are the services that translate and review: language models and translation
                engines. Ready-made entries are installed inactive. Enter a key (or use a free one
                without key), press <i>Test connection</i> and switch the entry on. Two or more
                active providers are needed for a real cross-check.
            </p>
        </field>
    </record>
</odoo>
