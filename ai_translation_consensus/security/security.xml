<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_ai_translation" model="res.groups.privilege">
        <field name="name">AI Translation</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_ai_translation_user" model="res.groups">
        <field name="name">Reviewer</field>
        <field name="comment">Sees the proposals and approves or rejects them.</field>
        <field name="privilege_id" ref="privilege_ai_translation"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_ai_translation_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="comment">Sets up rules, providers and the glossary.</field>
        <field name="privilege_id" ref="privilege_ai_translation"/>
        <field name="implied_ids" eval="[(4, ref('group_ai_translation_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
