<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Inactive until you switch it on. It only touches rules with "Scan and process automatically". -->
    <record id="ir_cron_ai_translation" model="ir.cron">
        <field name="name">AI Translation: scan and process rules</field>
        <field name="model_id" ref="model_ai_translation_watch"/>
        <field name="state">code</field>
        <field name="code">model._cron_run()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False"/>
    </record>
    <!-- Read-only: asks the signed-in command line tools (Codex, Antigravity) how much of their plan is used up. -->
    <record id="ir_cron_ai_translation_usage" model="ir.cron">
        <field name="name">AI Translation: read plan usage of the providers</field>
        <field name="model_id" ref="model_ai_translation_provider"/>
        <field name="state">code</field>
        <field name="code">model._cron_read_usage()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(minutes=10)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
