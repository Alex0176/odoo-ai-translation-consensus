<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Every preset is inactive. Activate it after entering a key or checking the endpoint. -->
    <record id="provider_pollinations" model="ai.translation.provider">
        <field name="name">Pollinations (keyless)</field>
        <field name="active" eval="False"/>
        <field name="sequence">10</field>
        <field name="kind">openai_nokey</field>
        <field name="base_url">https://text.pollinations.ai/openai</field>
        <field name="model">openai</field>
        <field name="role">both</field>
        <field name="is_local" eval="False"/>
        <field name="extra_json">{"min_interval": 46}</field>
        <field name="note">Free public endpoint, no key. Texts leave your server; quality and availability vary. The anonymous tier allows one reply every 45 seconds, so every call waits for that.</field>
    </record>
    <record id="provider_ollama" model="ai.translation.provider">
        <field name="name">Ollama (own server)</field>
        <field name="active" eval="False"/>
        <field name="sequence">11</field>
        <field name="kind">openai_nokey</field>
        <field name="base_url">http://localhost:11434/v1</field>
        <field name="model">llama3.1</field>
        <field name="role">both</field>
        <field name="is_local" eval="True"/>
        <field name="note">Models on your own hardware. Texts stay on your server, so it is allowed for confidential rules.</field>
    </record>
    <record id="provider_claude_cli" model="ai.translation.provider">
        <field name="name">Claude Code CLI (signed-in)</field>
        <field name="active" eval="False"/>
        <field name="sequence">12</field>
        <field name="kind">command</field>
        <field name="command">claude -p --tools "" --no-session-persistence</field>
        <field name="role">both</field>
        <field name="is_local" eval="False"/>
        <field name="note">Uses a signed-in command line tool, no key stored here. Needs the system parameter ai_translation_consensus.allow_command = True. Set the command line below.</field>
    </record>
    <record id="provider_antigravity_cli" model="ai.translation.provider">
        <field name="name">Antigravity CLI (signed-in)</field>
        <field name="active" eval="False"/>
        <field name="sequence">12</field>
        <field name="kind">command</field>
        <field name="command">agy -p "Do not use any tools or commands, answer directly with the requested JSON only. {prompt}" --mode plan --output-format text --print-timeout 10m</field>
        <field name="role">both</field>
        <field name="is_local" eval="False"/>
        <field name="note">Google's successor of the Gemini CLI, signed in as the Odoo system user (agy, then log in once). The prompt is passed as an argument ({prompt}). --mode plan keeps the tools off; without it agy tries to run commands and returns nothing in headless mode, and --dangerously-skip-permissions must not be used on foreign website text. Needs the system parameter ai_translation_consensus.allow_command = True. Give the full path to agy if it is not on the service's PATH.</field>
    </record>
    <record id="provider_mymemory" model="ai.translation.provider">
        <field name="name">MyMemory (keyless)</field>
        <field name="active" eval="False"/>
        <field name="sequence">13</field>
        <field name="kind">mymemory</field>
        <field name="base_url">https://api.mymemory.translated.net</field>
        <field name="role">translate</field>
        <field name="is_local" eval="False"/>
        <field name="note">Free, small daily quota, translates only.</field>
    </record>
